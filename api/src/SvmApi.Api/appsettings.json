{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Integration": {
    "UseMock": true
  },
  "Intake": {
    "MaxFileBytes": 5242880,
    "MaxRows": 5000,
    "MaxReportedErrors": 200
  },
  "Evidence": {
    "MaxFileBytes": 10485760
  },
  "Sla": {
    "MonitorEnabled": true,
    "MonitorIntervalMinutes": 5,
    "StartupDelaySeconds": 15,
    "NearDueThresholdPercent": 20,
    "OverdueEscalationDays": 3,
    "MaxInstancesPerRun": 1000
  },
  "ConnectionStrings": {
    "// Svm": "ค่าจริงมาจาก appsettings.{Environment}.json หรือ env var ConnectionStrings__Svm (ห้าม commit secret จริง — ดู tasks.md 1.4)"
  }
}
