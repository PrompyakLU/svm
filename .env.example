# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง — .env ถูก gitignore (ห้าม commit secret)
# ใช้สำหรับ docker-compose.yml (full stack local) และ docker-compose.dev.yml (SQL Server อย่างเดียว)

# รหัสผ่าน SA ของ SQL Server container (local dev เท่านั้น)
SVM_SA_PASSWORD=ChangeMe_Strong#Passw0rd

# connection string ที่ api/migrate ใช้ต่อ SQL Server
# host "sqlserver" = ชื่อ service ใน compose; TrustServerCertificate เพราะ cert self-signed ภายใน
SVM_CONNECTION_STRING=Server=sqlserver,1433;Database=svm;User Id=sa;Password=ChangeMe_Strong#Passw0rd;Encrypt=True;TrustServerCertificate=True

# JWT signing key — ต้องสุ่มอย่างน้อย 32 bytes (เช่น: openssl rand -base64 48)
SVM_JWT_SIGNING_KEY=REPLACE_WITH_RANDOM_BASE64_AT_LEAST_32_BYTES

# seed demo users (local/demo เท่านั้น — ไม่มี PII จริง)
SVM_SEED_ENABLED=true
SVM_SEED_DEMO_PASSWORD=ChangeMe_Demo#Passw0rd
